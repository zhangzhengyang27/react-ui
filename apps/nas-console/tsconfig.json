{
    "extends": "../../tsconfig.json",
    "include": ["src", "../../@types", "vite.config.ts"],
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true
    }
}
