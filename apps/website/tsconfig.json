{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "declaration": false,
        "forceConsistentCasingInFileNames": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./*"],
            "@react-ui/ui": ["../../packages/ui/src/index.ts"],
            "@react-ui/hooks": ["../../packages/hooks/src/index.ts"]
        }
    },
    "include": [
        "**/*.mdx",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "next-env.d.ts",
        "docs-dist/types/**/*.ts",
        ".docgen/**/*.json",
        ".docgen/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
