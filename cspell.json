{
    "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"],
    "caseSensitive": false,
    "dictionaries": ["custom-words", "lorem-ipsum"],
    "dictionaryDefinitions": [
        {
            "name": "custom-words",
            "path": "./.cspell/custom-words.txt",
            "addWords": true
        }
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/dist/**",
        "**/lib/**",
        "**/stats.html",
        "**/language/**",
        "**/language.ts",
        "**/docs/**",
        "**/package.json",
        "eslint.config.js",
        "**/vite.config.ts.timestamp-*.mjs",
        "**/shiki-themes.ts"
    ]
}
