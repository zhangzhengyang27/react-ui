{
  "name": "react-ui",
  "version": "1.0.0",
  "description": "小叶的 react ui 组件库",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:packages": "pnpm --filter './packages/**' --parallel dev",
    "dev:apps": "pnpm --filter './apps/**' --parallel dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:apps": "pnpm --filter './apps/**' build",
    "test": "pnpm -r test",
    "test:packages": "pnpm --filter './packages/**' test",
    "release": "pnpm build:packages && pnpm --filter './packages/**' release",
    "lint:es": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{packages,apps}/**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint \"{packages,apps}/**/*.{css,ts}\"",
    "docs:lint": "node apps/docs/scripts/lint-docs-imports.mjs",
    "typecheck:demos": "tsc -p apps/docs/tsconfig.demos.json",
    "lint": "npm run lint:es && npm run lint:style",
    "e2e:screenshots": "playwright test",
    "e2e:interactions": "playwright test -c playwright.interactions.config.ts",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "commit": "git-cz",
    "prepublishOnly:hooks": "cd packages/hooks && pnpm build && pnpm test",
    "prepublishOnly:ui": "cd packages/ui && pnpm build && pnpm test",
    "prepublishOnly:pro": "cd packages/@xiaoye-react/pro && pnpm build && pnpm test",
    "publish:hooks": "pnpm prepublishOnly:hooks && cd packages/hooks && npm publish --access public",
    "publish:ui": "pnpm prepublishOnly:ui && cd packages/ui && npm publish --access public",
    "publish:pro": "pnpm prepublishOnly:pro && cd packages/@xiaoye-react/pro && pnpm publish --access public",
    "publish:all": "pnpm publish:hooks && pnpm publish:ui && pnpm publish:pro",
    "release:tag": "git tag -a v2.0.0 -m \"release: v2.0.0\" && git push origin v2.0.0"
  },
  "author": "xiaoye",
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "9.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "20.14.9",
    "@types/react": "19.2.3",
    "commitizen": "4.3.0",
    "cspell": "8.9.1",
    "cz-git": "1.9.3",
    "eslint": "9.5.0",
    "playwright": "^1.61.1",
    "postcss-nested": "^7.0.1",
    "postcss-styled-syntax": "0.6.4",
    "prettier": "3.3.2",
    "react": "19.1.1",
    "stylelint": "16.6.1",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.5.2",
    "typescript-eslint": "8.63.0"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "dumi@2.4.47": "patches/dumi@2.4.47.patch"
    }
  }
}
