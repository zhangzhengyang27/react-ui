  "license": "MIT",
  "author": "Vitaly Rtishchev <rtivital@gmail.com>",
  "keywords": [
    "react",
    "ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./cjs/index.cjs",
