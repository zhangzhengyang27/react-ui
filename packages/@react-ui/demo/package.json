{
  "name": "@react-ui/demo",
  "version": "2.0.0",
  "description": "Demo base components used on *.mantine.dev websites",
  "homepage": "https://mantine.dev/",
  "license": "MIT",
  "author": "Vitaly Rtishchev <rtivital@gmail.com>",
  "keywords": [
    "react",
    "ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./cjs/index.cjs",
  "module": "./esm/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./styles.layer.css": "./styles.layer.css"
  },
  "repository": {
    "url": "https://github.com/mantinedev/mantine.git",
    "type": "git",
    "directory": "packages/@react-ui/demo"
  },
  "peerDependencies": {
    "@react-ui/code-highlight": "workspace:*",
    "@react-ui/ui": "workspace:*",
    "@react-ui/hooks": "workspace:*",
    "@react-ui/dev-icons": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shiki": ">=3.11.0"
  },
  "devDependencies": {
    "@react-ui/code-highlight": "workspace:*",
    "@react-ui/ui": "workspace:*",
    "@react-ui/hooks": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shiki": "^4.2.0"
  }
}
