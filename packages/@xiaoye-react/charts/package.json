        "@vitejs/plugin-react": "^4.3.1",
        "@xiaoye-react/hooks": "workspace:*",
        "@xiaoye-react/tests": "workspace:*",
        "@xiaoye-react/ui": "workspace:*",
        "jsdom": "^24.1.0",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "vitest": "^1.6.0"
