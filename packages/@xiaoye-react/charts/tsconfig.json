{
    "include": ["./src", "../../../@types"],
    "compilerOptions": {
        "rootDir": "src",

        "declaration": true,
        "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
        "target": "ES2015",
        "lib": ["DOM", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "emitDeclarationOnly": true,
        "outDir": "lib",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true
    }
}
