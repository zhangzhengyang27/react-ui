{
    "name": "@xiaoye-react/demo",
    "private": true,
    "version": "1.0.0",
    "description": "Demo base components used on *.react-ui.dev websites",
    "homepage": "https://react-ui.dev/",
    "license": "MIT",
    "author": "Vitaly Rtishchev <rtivital@gmail.com>",
    "keywords": [
        "react",
        "ui"
    ],
    "sideEffects": [
        "*.css"
    ],
    "main": "./cjs/index.cjs",
    "module": "./esm/index.mjs",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts"
        },
        "./styles.css": "./styles.css",
        "./styles.layer.css": "./styles.layer.css"
    },
    "repository": {
        "url": "https://github.com/react-ui/react-ui.git",
        "type": "git",
        "directory": "packages/@xiaoye-react/demo"
    },
    "peerDependencies": {
        "@xiaoye-react/ui": "workspace:*",
        "@xiaoye-react/hooks": "workspace:*",
        "@xiaoye-react/dev-icons": "workspace:*",
        "clsx": "^2.1.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "shiki": ">=3.11.0"
    },
    "devDependencies": {
        "@xiaoye-react/ui": "workspace:*",
        "@xiaoye-react/hooks": "workspace:*",
        "clsx": "^2.1.1",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "shiki": "^4.2.0"
    }
}
