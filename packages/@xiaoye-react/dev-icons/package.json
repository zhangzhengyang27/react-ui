{
  "name": "@xiaoye-react/dev-icons",
  "private": true,
  "version": "1.0.0",
  "description": "Dev icons used on *.react-ui.dev websites",
  "homepage": "https://react-ui.dev/",
  "license": "MIT",
  "author": "Vitaly Rtishchev <rtivital@gmail.com>",
  "keywords": [
    "react",
    "ui"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "repository": {
    "url": "https://github.com/react-ui/react-ui.git",
    "type": "git",
    "directory": "packages/@xiaoye-react/dev-icons"
  },
  "peerDependencies": {
    "@xiaoye-react/ui": "workspace:*",
    "@xiaoye-react/hooks": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@xiaoye-react/ui": "workspace:*",
    "@xiaoye-react/hooks": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
