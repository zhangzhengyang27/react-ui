        "@testing-library/user-event": "^14.5.2",
        "@types/react": "19.2.3",
        "@vitejs/plugin-react": "^4.3.1",
        "@xiaoye-react/hooks": "workspace:*",
        "@xiaoye-react/tests": "workspace:*",
        "@xiaoye-react/ui": "workspace:*",
        "jsdom": "^24.1.0",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "typescript": "5.5.2",
        "vitest": "^1.6.0"
    },
    "scripts": {
