{
    "name": "@react-ui/hooks",
    "version": "1.0.0",
    "description": "小叶的 React Hooks 库，用于 主要用于 UI 包使用",
    "type": "module",
    "main": "es/index.js",
    "module": "es/index.js",
    "types": "es/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.js",
            "require": "./es/index.js"
        }
    },
    "files": [
        "es"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "release": "npm publish"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.1",
        "jsdom": "^24.1.0",
        "typescript": "5.4.5",
        "vite": "^5.4.0",
        "vite-plugin-dts": "^4.3.0",
        "vitest": "^1.6.0"
    },
    "peerDependencies": {
        "react": "19.1.1",
        "react-dom": "19.1.1"
    }
}
