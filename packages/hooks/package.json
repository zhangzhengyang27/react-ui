{
    "name": "@xiaoye-react/hooks",
    "version": "1.4.0",
    "description": "小叶的 React Hooks 库，用于 主要用于 UI 包使用",
    "type": "module",
    "license": "MIT",
    "author": "xiaoye",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhangzhengyang27/react-ui.git",
        "directory": "packages/hooks"
    },
    "homepage": "https://github.com/zhangzhengyang27/react-ui",
    "keywords": [
        "react",
        "hooks",
        "typescript"
    ],
    "sideEffects": false,
    "main": "es/index.cjs",
    "module": "es/index.js",
    "types": "es/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.js",
            "require": "./es/index.cjs"
        }
    },
    "files": [
        "es"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "release": "pnpm publish",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.1",
        "jsdom": "^24.1.0",
        "typescript": "5.5.2",
        "vite": "^5.4.0",
        "vite-plugin-dts": "^4.3.0",
        "vitest": "^1.6.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
