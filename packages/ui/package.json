{
    "name": "@react-ui/ui",
    "version": "0.0.1",
    "description": "小叶的 react ui 组件库",
    "type": "module",
    "main": "es/index.js",
    "module": "es/index.js",
    "types": "es/index.d.ts",
    "files": [
        "es"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "release": "npm publish"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.19",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "react-number-format": "^5.4.5",
        "react-remove-scroll": "^2.7.2",
        "recharts": "^3.9.2",
        "type-fest": "4.41.0"
    },
    "devDependencies": {
        "@react-ui/hooks": "workspace:*",
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.1",
        "jsdom": "^24.1.0",
        "postcss-nested": "^7.0.1",
        "typescript": "5.4.5",
        "vite": "^5.4.0",
        "vite-plugin-dts": "^4.3.0",
        "vitest": "^1.6.0"
    },
    "peerDependencies": {
        "@react-ui/hooks": "workspace:*",
        "react": "19.1.1",
        "react-dom": "19.1.1"
    },
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.js",
            "require": "./es/index.js"
        },
        "./style.css": "./es/style.css",
        "./es/*": "./es/*"
    }
