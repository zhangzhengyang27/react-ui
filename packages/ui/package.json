{
    "name": "@xiaoye-react/ui",
    "version": "2.1.0",
    "description": "小叶的 react ui 组件库",
    "type": "module",
    "license": "MIT",
    "author": "xiaoye",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xiaoye/react-ui.git",
        "directory": "packages/ui"
    },
    "keywords": [
        "react",
        "ui",
        "components",
        "component-library",
        "typescript",
        "hooks"
    ],
    "sideEffects": false,
    "main": "es/index.cjs",
    "module": "es/index.js",
    "types": "es/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "es"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "release": "npm publish",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.19",
        "@tanstack/react-virtual": "^3.13.0",
        "clsx": "^2.1.1",
        "embla-carousel-react": "^8.6.0",
        "react-number-format": "^5.4.5",
        "react-remove-scroll": "^2.7.2",
        "type-fest": "4.41.0",
        "react-dropzone": "15.0.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^16.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.1",
        "@xiaoye-react/hooks": "workspace:*",
        "jsdom": "^24.1.0",
        "postcss-nested": "^7.0.1",
        "typescript": "5.5.2",
        "vite": "^5.4.0",
        "vite-plugin-dts": "^4.3.0",
        "vitest": "^1.6.0",
        "@xiaoye-react/tests": "workspace:*"
    },
    "peerDependencies": {
        "@xiaoye-react/hooks": "^1.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.js",
            "require": "./es/index.cjs"
        },
        "./style.css": "./es/style.css",
        "./es/*": "./es/*"
    }
}
