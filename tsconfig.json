{
    "compilerOptions": {
        "target": "ES2015",
        "lib": ["DOM", "ESNext"],
        "allowJs": true,
        "module": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "experimentalDecorators": true,
        "moduleResolution": "bundler"
    },
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Base",
    "include": ["packages/**/*"],
    "exclude": ["**/*.timestamp-*.mjs", "**/node_modules", "**/es", "**/dist"]
}
